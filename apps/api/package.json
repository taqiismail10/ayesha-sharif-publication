{
  "name": "@asp/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for Ayesha-Sharif Publication (Phase 0 foundation).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker:dev": "wrangler dev --local",
    "worker:dev:remote": "wrangler dev --remote",
    "worker:types": "wrangler types src/worker-configuration.d.ts --env-interface WorkerEnv",
    "worker:dry-run": "wrangler deploy --dry-run",
    "test:d1-integrity": "npm run build && node test/d1-integrity.local.cjs",
    "test:uploads:local": "npm run build && node test/uploads.local.cjs",
    "test:orders-export:local": "npm run build && node test/orders-export.local.cjs",
    "test:admin-reads:local": "npm run build && node test/admin-reads.local.cjs",
    "test:admin-customers:local": "npm run build && node test/admin-reads.local.cjs",
    "test:admin-book-delete:local": "npm run build && node test/admin-reads.local.cjs",
    "test:public-catalogue:local": "npm run build && node test/public-catalogue.local.cjs",
    "test:order-confirmation:local": "npm run build && node test/order-confirmation.local.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma --generator apiClient"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.18",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^7.10.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.131.1"
  }
}
