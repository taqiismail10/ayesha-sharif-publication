# ── ASP NestJS API — environment variables (Phase 0) ─────────────────────────
# Copy to apps/api/.env for local development. Never commit real secrets.

# PostgreSQL connection — SAME database the Next.js app uses.
# (Variable intentionally NOT renamed yet; see migration plan §8.3.)
# IMPORTANT: exactly ONE DATABASE_URL line. A duplicate empty `DATABASE_URL=`
# earlier in the file silently wins and the API starts without a database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# Port the API listens on. The Next.js frontend stays on 3000.
API_PORT=4000

# Allowed CORS origin(s) for the Next.js frontend. Comma-separated for multiple.
FRONTEND_ORIGIN="http://localhost:3000"

# Session/IP-hash secret — use the SAME value as the Next.js app's
# NEXTAUTH_SECRET so hashes match across both backends.
NEXTAUTH_SECRET="same-value-as-the-next-app"

# ── Google OAuth (Phase 2C) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). See docs/GOOGLE_OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/customer/google/callback"

# Where the browser is sent after OAuth completes (the Next.js app).
FRONTEND_URL="http://localhost:3000"

# ── Brevo SMTP transactional email ──────────────────────────────────────────
# SMTP_PASS must be a Brevo SMTP key, not the Brevo account password.
EMAIL_PROVIDER="brevo"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="AS Publications"

# Public origins used when constructing auth/email links.
BACKEND_URL="http://localhost:4000"
