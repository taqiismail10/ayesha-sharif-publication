generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  super_admin
  admin
  editor
  order_manager
}

enum BookStatus {
  draft
  upcoming
  pre_order
  published
  out_of_stock
  archived
}

enum PaymentMethod {
  cash_on_delivery
  bkash
  nagad
  rocket
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
}

enum CustomerBookEventType {
  view
  add_to_cart
  purchase
  search_click
  sample_open
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(admin)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Book {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  subtitle         String?
  author           String
  publisher        String              @default("Ayesha-Sharif Publication")
  isbn13           String?             @unique
  edition          String?
  language         String              @default("Bangla")
  pages            Int?
  binding          String?
  publicationDate  DateTime?
  shortDescription String?
  description      String?
  regularPrice     Decimal             @db.Decimal(10, 2)
  salePrice        Decimal             @db.Decimal(10, 2)
  discountPercent  Int                 @default(0)
  discountStart    DateTime?
  discountEnd      DateTime?
  stockQuantity    Int                 @default(0)
  status           BookStatus          @default(draft)
  coverImage       String?
  galleryImages    String[]            @default([])
  samplePdf        String?
  weight           Int?
  isFeatured       Boolean             @default(false)
  isBestSeller     Boolean             @default(false)
  isNewArrival     Boolean             @default(false)
  isRecommended    Boolean             @default(false)
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id])
  tags             BookTag[]
  orderItems       OrderItem[]
  customerEvents   CustomerBookEvent[]
  savedByCustomers SavedBook[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([title])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  books     BookTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BookTag {
  bookId String
  tagId  String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  district        String
  deliveryArea    String
  subtotal        Decimal       @db.Decimal(10, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(10, 2)
  deliveryCharge  Decimal       @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(cash_on_delivery)
  paymentStatus   PaymentStatus @default(unpaid)
  orderStatus     OrderStatus   @default(pending)
  transactionId   String?
  courierName     String?
  trackingNumber  String?
  notes           String?
  adminNote       String?
  stockReduced    Boolean       @default(false)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([customerPhone])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  bookId            String
  bookTitleSnapshot String
  quantity          Int
  unitPrice         Decimal @db.Decimal(10, 2)
  totalPrice        Decimal @db.Decimal(10, 2)
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book              Book    @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  position  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([position, title])
  @@index([position])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id           String              @id @default(cuid())
  name         String
  email        String?             @unique
  phone        String?             @unique
  passwordHash String
  isActive     Boolean             @default(true)
  lastLoginAt  DateTime?
  profile      CustomerProfile?
  sessions     CustomerSession[]
  preferences  CustomerPreference?
  events       CustomerBookEvent[]
  savedBooks   SavedBook[]
  orders       Order[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([email])
  @@index([phone])
}

model CustomerProfile {
  id                     String   @id @default(cuid())
  customerId             String   @unique
  displayName            String?
  phone                  String?
  email                  String?
  defaultDistrict        String?
  defaultDeliveryArea    String?
  defaultAddress         String?
  avatarUrl              String?
  marketingConsent       Boolean  @default(false)
  personalizationConsent Boolean  @default(false)
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  ipHash     String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerBookEvent {
  id          String                @id @default(cuid())
  customerId  String?
  anonymousId String?
  bookId      String
  eventType   CustomerBookEventType
  weight      Int                   @default(1)
  source      String?
  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  book        Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([bookId, eventType])
}

model CustomerPreference {
  id                  String   @id @default(cuid())
  customerId          String   @unique
  preferredCategories Json     @default("[]")
  preferredTags       Json     @default("[]")
  preferredLanguages  Json?
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SavedBook {
  id         String   @id @default(cuid())
  customerId String
  bookId     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, bookId])
  @@index([customerId])
  @@index([bookId])
}
